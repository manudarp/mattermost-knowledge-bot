# Mattermost
MM_URL=https://mattermost.example.com
MM_BOT_TOKEN=
MM_BOT_USERNAME=wikibot
MM_BOT_USER_ID=

# comma-separated list of mention triggers (without leading @)
BOT_TRIGGER_MENTIONS=wikibot,kb,knowledge-bot
# usernames allowed to manage bot-wide collections (empty = everyone)
BOT_ADMINS=

# Outline
OUTLINE_URL=https://wiki.example.com
OUTLINE_API_TOKEN=
# Collections (names, URLs or IDs, comma-separated) available in EVERY channel.
# More can be linked at runtime with `@wikibot collezioni aggiungi <nome>`.
OUTLINE_COLLECTIONS=
# Legacy: create a dedicated collection whenever the bot joins a channel
AUTO_CREATE_CHANNEL_COLLECTION=false

# --- LLM: OpenAI-compatible endpoint (local llama.cpp/vLLM or hosted provider) ---
# Local:      LLM_BASE_URL=http://localhost:8020
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Optional extra headers as JSON (OpenRouter attribution, etc.)
# LLM_EXTRA_HEADERS={"HTTP-Referer":"https://wiki.example.com","X-Title":"Knowledge Bot"}
LLM_EXTRA_HEADERS=
# OpenRouter only: provider constraints sent with every request (privacy belt-and-braces)
# LLM_PROVIDER_PREFS={"zdr":true,"data_collection":"deny"}
LLM_PROVIDER_PREFS=
# OpenRouter only: ordered fallback models if LLM_MODEL fails
LLM_FALLBACK_MODELS=
# Parallel LLM calls: 1 for single-slot llama.cpp, higher for hosted providers
LLM_MAX_CONCURRENCY=1
LLM_TIMEOUT_MS=300000
# Upper bound when the bot retries a cut-off/empty reply with a bigger budget
LLM_MAX_OUTPUT_TOKENS=16000
# OpenRouter only, for reasoning models: low | medium | high (empty = provider default)
LLM_REASONING_EFFORT=
# Append Qwen's /no_think switch to prompts
LLM_NO_THINK_HINT=true

# --- LLM: Anthropic (used only when LLM_BASE_URL is empty) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Embeddings (semantic search) ---
# ollama → local Ollama (OLLAMA_URL); openai → OpenAI-compatible API (OpenRouter, Mistral…)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
# Example, hosted on OpenRouter (Mistral, ZDR endpoint):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=mistralai/mistral-embed-2312
# EMBEDDING_PROVIDER_PREFS={"zdr":true,"data_collection":"deny"}
# EMBEDDING_BATCH_SIZE=64
EMBEDDING_BASE_URL=
# empty = reuse LLM_API_KEY
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER_PREFS=
# texts per request: keep small (8) for a slow local CPU
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_MS=300000
OLLAMA_URL=http://ollama:11434
INDEX_SYNC_INTERVAL_MINUTES=60

# Chunking & retrieval
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=200
SEARCH_TOP_K=8
SEARCH_MAX_CHUNKS_PER_DOC=4

# Questions
GENERAL_QA_ENABLED=true
SEARCH_SCORE_THRESHOLD=0.3

# Saving to Outline (human-in-the-loop)
# always         → every change needs approval in Mattermost
# auto_high_conf → non-destructive changes above the threshold are applied directly
SAVE_APPROVAL_MODE=always
CONFIRMATION_CONFIDENCE_THRESHOLD=0.85
# usernames who can approve anyone's proposals (the requester always can)
SAVE_APPROVERS=
# audit section appended to every document the bot touches (empty = disabled)
SAVE_CHANGELOG_HEADING=Storico aggiornamenti
CONFIRMATION_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=5

# Storage
DB_PATH=/app/data/kb-bot.db

# Logging
LOG_LEVEL=info
NODE_ENV=production
